# Deliberately empty: the API is same-origin in both environments.
#
#   dev  - vite.config.js proxies /api to http://localhost:3456
#   prod - CloudFront routes /api/* to the load balancer
#
# Setting a value here points the build at a cross-site host, which the browser
# answers by dropping the sameSite=strict session cookie. See src/api/config.js.
VITE_API_URL=
