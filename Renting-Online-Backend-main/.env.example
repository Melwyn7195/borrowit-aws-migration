# Backend configuration — copy to `.env` for local development.
#
# On Fargate none of this comes from a file. AppStack injects DB_* from the
# Secrets Manager secret that RDS generated, and sets the rest as plain task
# definition environment variables. Never commit a filled-in .env.

# --- Database -----------------------------------------------------------------
# Local dev sets a full URL. In AWS the RDS secret arrives as discrete fields
# instead, and db/index.js builds the URL from DB_HOST / DB_PORT / DB_USER /
# DB_PASSWORD / DB_NAME when DATABASE_URL is absent.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/borrowit

# "disable" turns TLS off entirely — local Postgres only.
DB_SSL=disable

# Point at the RDS regional CA bundle for full certificate verification. Without
# it the connection is still encrypted, the server cert just is not verified.
# RDS_CA_CERT_PATH=

# db.t4g.micro tops out near 80 connections, shared across every running task.
DB_POOL_MAX=10

# --- Server -------------------------------------------------------------------
PORT=3456
NODE_ENV=development

# Graceful shutdown. Keep DRAIN_DELAY_MS below the ALB target group's
# deregistration delay, and DRAIN_DELAY_MS + DRAIN_TIMEOUT_MS below the ECS task
# StopTimeout (30s default).
DRAIN_DELAY_MS=5000
DRAIN_TIMEOUT_MS=20000

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-32-byte-hex-string
JWT_EXPIRE=7d

# Optional. Falls back to JWT_SECRET when unset — see userController.js.
# JWT_REFRESH_SECRET=

# --- Frontend origin ----------------------------------------------------------
# Used to build links in outgoing email. In production the app is same-origin
# behind CloudFront, so this is the distribution URL, not an API host.
FRONTEND_URL=http://localhost:5173
# NEW_FRONTEND_URL=

# --- Uploads ------------------------------------------------------------------
# On Fargate the task role supplies credentials; locally the SDK falls back to
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from this file.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
# Serve uploads through CloudFront rather than the bucket directly.
# ASSET_BASE_URL=https://<distribution>.cloudfront.net

# --- Email --------------------------------------------------------------------
# Unset, EmailService logs the message instead of sending it.
SEND_EMAILS=false
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
